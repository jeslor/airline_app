// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DBURL")
}

// A Booking is created as soon as the passenger submits their details
// (status PENDING_PAYMENT) and only becomes CONFIRMED once the Stripe
// webhook reports the PaymentIntent succeeded. Flights are AI-generated
// per search rather than stable inventory, so the chosen legs are stored
// as embedded snapshots rather than foreign keys.
model Booking {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  bookingReference      String   @unique
  status                String   @default("PENDING_PAYMENT") // PENDING_PAYMENT | CONFIRMED | FAILED

  passenger             Json
  flights               Json // ordered array of signed flight offers (1 = one-way, 2 = round trip, 3+ = multi-city)

  currency              String   @default("usd")
  amountTotal           Int // authoritative charge amount, in cents

  stripePaymentIntentId String?  @unique

  ticketNumber          String?
  seatNumbers           Json? // array of seat strings, parallel to `flights`

  bookingDate           String
  bookingTime           String

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status])
}
